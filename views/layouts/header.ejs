
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/output.css">

    <title><%= title %></title>
</head>

<body class="bg-gray-100">

    <header class="bg-blue-600 text-white p-4">

        <div class="container mx-auto flex justify-between items-center">

            <a class="text-xl font-bold" href="/">
                Expense Tracker
            </a>

            <nav class="flex gap-5 items-center">

                <!-- Logged In -->
                <div
                    id="loggedInLinks"
                    class="hidden gap-5 items-center"
                >

                    <a
                        href="/expenses"
                        class="hover:text-gray-200"
                    >
                        View Expenses
                    </a>

                    <a
                        href="/expenses/add"
                        class="hover:text-gray-200"
                    >
                        Add Expense
                    </a>

                    <button
                        type="button"
                        onclick="handleLogout()"
                        class="hover:text-gray-200"
                    >
                        Logout
                    </button>
                    <button type="button" id="buyPremiumBtn" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-yellow-400 via-amber-500 to-orange-500 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-amber-500/30 transition-all duration-300 hover:-translate-y-0.5 hover:scale-105 hover:shadow-xl hover:shadow-amber-500/40">
                        Buy peremium membership
                    </button>

                </div>


                <!-- Logged Out -->
                <div
                    id="loggedOutLinks"
                    class="flex gap-5 items-center"
                >

                    <a
                        href="/register"
                        class="hover:text-gray-200"
                    >
                        SignUp
                    </a>

                    <a
                        href="/login"
                        class="hover:text-gray-200"
                    >
                        Login
                    </a>

                </div>

            </nav>

        </div>

    </header>

    <main class="container mx-auto p-6">


    <script>

        document.addEventListener('DOMContentLoaded', () => {

            const token = localStorage.getItem('token');

            const loggedInLinks = document.getElementById('loggedInLinks');
            const loggedOutLinks = document.getElementById('loggedOutLinks');


            if (token) {

                loggedInLinks.classList.remove('hidden');
                loggedInLinks.classList.add('flex');

                loggedOutLinks.classList.add('hidden');

            } else {

                loggedInLinks.classList.add('hidden');

                loggedOutLinks.classList.remove('hidden');
                loggedOutLinks.classList.add('flex');

            }

        });


        const handleLogout = () => {

            localStorage.removeItem('token');
            localStorage.removeItem('user');

            window.location.href = '/login';

        };

    </script>
