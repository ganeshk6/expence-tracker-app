<%- include('../../layouts/header', { title: 'Expense Leaderboard - Expense Tracker' }) %>

<div class="max-w-5xl mx-auto">

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">

        <div class="p-6 border-b">
            <h1 class="text-2xl font-bold text-gray-800">
                🏆 Expense Leaderboard
            </h1>

            <p class="text-gray-500 mt-1">
                Users ranked by their total expenses
            </p>
        </div>

        <div class="overflow-x-auto">

            <table class="w-full text-left">

                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-6 py-4 text-sm font-semibold text-gray-600">
                            Rank
                        </th>

                        <th class="px-6 py-4 text-sm font-semibold text-gray-600">
                            User
                        </th>

                        <th class="px-6 py-4 text-sm font-semibold text-gray-600 text-right">
                            Total Expense
                        </th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-gray-200">

                    <% users.forEach((user, index) => { %>

                        <tr class="hover:bg-gray-50 transition">

                            <!-- Rank -->
                            <td class="px-6 py-4">
                                <% if (index === 0) { %>
                                    <span class="text-2xl">🥇</span>
                                <% } else if (index === 1) { %>
                                    <span class="text-2xl">🥈</span>
                                <% } else if (index === 2) { %>
                                    <span class="text-2xl">🥉</span>
                                <% } else { %>
                                    <span class="font-semibold text-gray-600">
                                        <%= index + 1 %>
                                    </span>
                                <% } %>
                            </td>

                            <!-- User -->
                            <td class="px-6 py-4">
                                <div class="font-semibold text-gray-800">
                                    <%= user.full_name %>
                                </div>
                            </td>

                            <!-- Total Expense -->
                            <td class="px-6 py-4 text-right">
                                <span class="font-bold text-red-600">
                                    ₹<%= Number(user.dataValues.totalExpense || 0).toLocaleString('en-IN') %>
                                </span>
                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>

<%- include('../../layouts/footer') %>