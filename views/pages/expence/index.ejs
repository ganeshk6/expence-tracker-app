<%- include('../../layouts/header', { title: 'All Expenses - Expense Tracker' }) %>
<div class="flex justify-between items-center mb-5">
    <p class="text-2xl font-bold text-gray-800">All Expenses</p>

    <button class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 hidden" id="download-expense-btn">
        Download
    </button>
</div>
<div class="mt-6 overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
    <table class="w-full text-left text-sm text-gray-600">
        <thead class="bg-gray-100 text-xs uppercase text-gray-700">
            <tr>
                <th class="px-6 py-4">Amount</th>
                <th class="px-6 py-4">Category</th>
                <th class="px-6 py-4">Description</th>
                <th class="px-6 py-4">Action</th>
            </tr>
        </thead>

        <tbody id="expenseListTableBody" class="divide-y divide-gray-200 bg-white">
        </tbody>
    </table>
    <div id="pagination" class="flex justify-center items-center gap-2 mt-6 pb-3"></div>
</div>
<%- include('../../layouts/footer') %>